{
  "name": "wolfy-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Веб-версия Wolfy: читалка английских книг с разбором слова и колодой повторений",
  "scripts": {
    "core": "bash ../tools/build_wasm.sh",
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-bundle-budget.mjs",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "budget": "node scripts/check-bundle-budget.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.62.11",
    "@tanstack/react-router": "^1.95.1",
    "comlink": "^4.4.2",
    "motion": "^11.15.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.2.7"
  }
}
