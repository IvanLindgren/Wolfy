{
  "name": "Wolfy — читалка английских книг",
  "short_name": "Wolfy",
  "description": "Тап по слову даёт перевод, разбор формы и грамматику предложения, а отмеченные слова уходят в колоду повторений.",
  "lang": "ru",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#fbf9f5",
  "theme_color": "#fbf9f5",
  "categories": ["books", "education"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Продолжить чтение", "url": "/reader", "description": "Открыть книгу там, где закрыли" },
    { "name": "Тренировка", "url": "/decks", "description": "Сегодняшняя порция повторений" }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "application/epub+zip": [".epub"],
        "application/pdf": [".pdf"],
        "text/plain": [".txt"]
      },
      "launch_type": "single-client"
    }
  ],
  "launch_handler": { "client_mode": "focus-existing" },
  "share_target": {
    "action": "/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "book",
          "accept": ["application/epub+zip", "application/pdf", "text/plain"]
        }
      ]
    }
  }
}
