# Скопируй в .env и заполни. Реальный .env в git не попадает.

# Порт и режим сервиса
WOLFY_ADDR=:8080
WOLFY_ENV=dev

# Публичный адрес этого API, который запекается в Windows/Android при сборке.
# В окружении уже установленного desktop-приложения может его переопределить.
WOLFY_SERVER_URL=http://localhost:8080

# Origin веб-клиента. Если SPA и API раздаются одним доменом, оставьте пустым.
# Для отдельного dev/prod origin значение включает схему и порт, без пути.
WOLFY_WEB_ORIGIN=http://localhost:5180

# Postgres. В разработке — контейнер из docker-compose.yml,
# в проде — тот же инстанс, что у Читавука, схема wolfy.
WOLFY_DB_URL=postgres://wolfy:wolfy@localhost:5433/wolfy?sslmode=disable

# Redis для кэша переводов и разборов
WOLFY_REDIS_URL=redis://localhost:6379/3

# Wolfy проверяет непрозрачные токены Читавука по общей таблице sessions в
# WOLFY_DB_URL. Отдельного JWT-секрета у этого протокола нет.

# Вход делегирован Читавуку: Wolfy передаёт форму входа этому endpoint и
# сохраняет на устройстве выданный JWT. Пароль Wolfy не хранит.
WOLFY_CITAVUK_LOGIN_URL=https://api.citavuk.ru/v1/auth/login
# Регистрация и повторное письмо с подтверждением. Пустой адрес прячет
# соответствующую кнопку в приложении.
WOLFY_CITAVUK_REGISTER_URL=https://api.citavuk.ru/v1/auth/register
WOLFY_CITAVUK_RESEND_URL=https://api.citavuk.ru/v1/auth/resend-verification

# Социальный вход остаётся общим с Читавуком. Яндекс использует OAuth-клиент
# Читавука; Wolfy только передаёт start/complete и возвращает результат в
# приложение через одноразовый адрес на 127.0.0.1.
WOLFY_CITAVUK_GOOGLE_URL=https://api.citavuk.ru/v1/auth/google
WOLFY_CITAVUK_YANDEX_START_URL=https://api.citavuk.ru/v1/auth/yandex/start
WOLFY_CITAVUK_YANDEX_COMPLETE_URL=https://api.citavuk.ru/v1/auth/yandex/complete

# Google требует отдельный Web OAuth client для домена сервера Wolfy.
# В Google Cloud в Authorized redirect URIs добавьте точное значение
# WOLFY_GOOGLE_CALLBACK_URL. Тот же client ID должен быть разрешён Читавуком
# как доверенная аудитория ID token.
WOLFY_GOOGLE_CLIENT_ID=
WOLFY_GOOGLE_CLIENT_SECRET=
WOLFY_GOOGLE_CALLBACK_URL=https://api.wolfy.example/v1/auth/google/callback
# Случайная строка минимум 32 символа. Шифрует OAuth state с PKCE.
WOLFY_OAUTH_STATE_SECRET=

# Публичная лента новых релизов Standard Ebooks. Полный каталог требует
# выданных Standard Ebooks реквизитов; при их наличии укажите защищённый feed
# и пару WOLFY_STANDARD_EBOOKS_USER / WOLFY_STANDARD_EBOOKS_PASSWORD.
WOLFY_STANDARD_EBOOKS_FEED_URL=https://standardebooks.org/feeds/atom/new-releases
WOLFY_STANDARD_EBOOKS_USER=
WOLFY_STANDARD_EBOOKS_PASSWORD=

# Офлайн-словарь и лежащий рядом wolfy_dictionary.tsv.gz.
WOLFY_DICTIONARY_PATH=../dist/wolfy_dictionary.tsv

# MSI и APK для автоматического обновления. Сервер сам выбирает из каталога
# пакет с наибольшей версией и вычисляет его SHA-256.
WOLFY_RELEASES_PATH=../dist

# DeepL — контекстный перевод предложений и слов
DEEPL_API_KEY=

# OCR «книга по фото»: OpenAI-совместимый провайдер (как photoscan Читавука)
WOLFY_OCR_KEY=
WOLFY_OCR_MODEL=google/gemini-3.7-flash
WOLFY_OCR_URL=https://api.polza.ai/api/v1/chat/completions
