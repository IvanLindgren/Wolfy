# Скопируй в .env и заполни. Реальный .env в git не попадает.
# Значения пишутся без кавычек: KEY=значение, а не KEY="значение".
# Кавычки по краям сервис снимает сам, но лишними они не становятся.

# Порт и режим сервиса
WOLFY_ADDR=:8080
WOLFY_ENV=dev

# Публичный адрес этого API, который запекается в Windows/Android при сборке.
# В окружении уже установленного desktop-приложения может его переопределить.
WOLFY_SERVER_URL=http://localhost:8080

# Origin веб-клиента. Если SPA и API раздаются одним доменом, оставьте пустым.
# Для отдельного dev/prod origin значение включает схему и порт, без пути.
WOLFY_WEB_ORIGIN=http://localhost:5180

# Postgres. В разработке — контейнер из docker-compose.yml,
# в проде — тот же инстанс, что у Читавука, схема wolfy.
WOLFY_DB_URL=postgres://wolfy:wolfy@localhost:5433/wolfy?sslmode=disable

# Redis для кэша переводов и разборов
WOLFY_REDIS_URL=redis://localhost:6379/3

# Wolfy проверяет непрозрачные токены Читавука по общей таблице sessions в
# WOLFY_DB_URL. Отдельного JWT-секрета у этого протокола нет.

# Вход делегирован Читавуку: Wolfy передаёт форму входа этому endpoint и
# сохраняет на устройстве выданный JWT. Пароль Wolfy не хранит.
WOLFY_CITAVUK_LOGIN_URL=https://api.citavuk.ru/v1/auth/login
# Регистрация и повторное письмо с подтверждением. Пустой адрес прячет
# соответствующую кнопку в приложении.
WOLFY_CITAVUK_REGISTER_URL=https://api.citavuk.ru/v1/auth/register
WOLFY_CITAVUK_RESEND_URL=https://api.citavuk.ru/v1/auth/resend-verification

# Социальный вход остаётся общим с Читавуком.
WOLFY_CITAVUK_GOOGLE_URL=https://api.citavuk.ru/v1/auth/google
WOLFY_CITAVUK_YANDEX_START_URL=https://api.citavuk.ru/v1/auth/yandex/start
WOLFY_CITAVUK_YANDEX_COMPLETE_URL=https://api.citavuk.ru/v1/auth/yandex/complete
# Включать только на Читавуке с поддержкой trusted returnUrl и после добавления
# https://wolfy.citavuk.ru в CITAVUK_ALLOWED_ORIGINS. Для старых установок
# companion-патч лежит в docs/ops/citavuk-wolfy-oauth.patch.
WOLFY_CITAVUK_YANDEX_WEB_RETURN=false

# Публичный Web client ID Google Identity Services. Тот же ID должен входить в
# GOOGLE_CLIENT_ID_WEB (или GOOGLE_CLIENT_IDS) Читавука, а
# https://wolfy.citavuk.ru — быть Authorized JavaScript origin в Google Cloud.
# Client secret для web-входа не нужен.
WOLFY_GOOGLE_WEB_CLIENT_ID=

# Параметры code+PKCE ниже нужны только установленным клиентам. В Google Cloud
# добавьте точное WOLFY_GOOGLE_CALLBACK_URL в Authorized redirect URIs, а тот
# же client ID разрешите Читавуку как доверенную аудиторию ID token.
WOLFY_GOOGLE_CLIENT_ID=
WOLFY_GOOGLE_CLIENT_SECRET=
WOLFY_GOOGLE_CALLBACK_URL=https://wolfy.citavuk.ru/v1/auth/google/callback
# Случайная строка минимум 32 символа. Шифрует OAuth state с PKCE.
WOLFY_OAUTH_STATE_SECRET=


# Лента книг — Project Gutenberg через каталог Gutendex. Ни ключей, ни
# регистрации: значение по умолчанию рабочее. Переменная нужна, только чтобы
# подставить зеркало, если основной адрес недоступен.
WOLFY_GUTENDEX_URL=https://gutendex.com/books/

# Офлайн-словарь и лежащий рядом wolfy_dictionary.tsv.gz.
WOLFY_DICTIONARY_PATH=../dist/wolfy_dictionary.tsv

# MSI и APK для автоматического обновления. Сервер сам выбирает из каталога
# пакет с наибольшей версией и вычисляет его SHA-256. На VDS по умолчанию это
# /opt/wolfy/shared/releases — постоянный каталог между релизами.
WOLFY_RELEASES_PATH=../dist

# Закрытое хранилище загруженных книг. В production по умолчанию создаётся
# /opt/wolfy/shared/book-files; эта переменная нужна только для переопределения.
# WOLFY_BOOK_FILES_PATH=/opt/wolfy/shared/book-files

# DeepL — контекстный перевод предложений и слов
DEEPL_API_KEY=

# OCR «книга по фото»: OpenAI-совместимый провайдер (как photoscan Читавука)
WOLFY_OCR_KEY=
WOLFY_OCR_MODEL=google/gemini-3.7-flash
WOLFY_OCR_URL=https://api.polza.ai/api/v1/chat/completions
# AI-подсказки читателю (разбор фраз, вспомнить сюжет, компаньон). Ключ и адрес
# по умолчанию берутся у OCR выше: это тот же аккаунт и тот же протокол.
#
# А модель — своя, и наследовать её у OCR больше нельзя. Раньше наследовала, и
# незаданный WOLFY_AI_MODEL молча уводил весь текст разборов и пересказов в
# модель для распознавания фотографий. Ей нужно зрение, тексту не нужно, а
# платится за это на порядок больше: у Polza за миллион токенов
# google/gemini-3.7-flash стоит 89.17 на входе и 445.83 на выходе, а
# z-ai/glm-5.3-flash — 8.92 и 29.72. Вход тут большой: в пересказ уезжает до
# восемнадцати тысяч знаков прочитанного.
WOLFY_AI_MODEL=z-ai/glm-5.3-flash
# response_format включается по возможности endpoint, а не по имени модели.
WOLFY_AI_JSON_MODE=true
# Сколько ждать одну модель. Отдельно от общего таймаута внешних запросов:
# пересказ на восемнадцать тысяч знаков у бесплатной модели за двадцать секунд
# не успевает, а по общему таймауту он уходил в резерв, где следующая модель
# не успевала тем более.
WOLFY_AI_TIMEOUT_SECONDS=45
# Резерв для Beta-функций компаньона. Сервер также понимает старое имя
# WOLFY_OPENROUTER, чтобы существующий production env не пришлось ломать.
# Эти бесплатные модели используются как fallback при отказе основного провайдера.
WOLFY_OPENROUTER_KEY=
WOLFY_OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,z-ai/glm-5.2:free,openrouter/free
