<?xml version="1.0" encoding="utf-8"?>
<!--
  Обновление раз в полчаса — нижний предел, который система вообще соблюдает
  (меньше тридцати минут она молча игнорирует). Чаще и не нужно: место в книге
  меняется, только когда её читают, а во время чтения виджета на экране нет.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/widget_book"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description" />
