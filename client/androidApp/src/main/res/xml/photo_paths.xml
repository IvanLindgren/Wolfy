<?xml version="1.0" encoding="utf-8"?>
<!--
    Камере открыт ровно один каталог — тот, куда кладётся снимок страницы.
    Открывать больше нельзя: через ссылку провайдера чужое приложение получает
    доступ ко всему, что здесь перечислено.
-->
<paths>
    <cache-path name="photos" path="photos/" />
    <!-- Проверенный APK доступен только системному установщику и только после
         явного нажатия кнопки перезапуска в Wolfy. -->
    <cache-path name="updates" path="updates/" />
</paths>
