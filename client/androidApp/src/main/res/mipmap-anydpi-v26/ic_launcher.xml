<?xml version="1.0" encoding="utf-8"?>
<!--
  Иконка приложения: волк на цвете газетной бумаги.

  Adaptive icon, а не одна картинка: система сама обрезает её маской под форму,
  принятую на устройстве, — круг, квадрат со скруглением или каплю. Поэтому
  фигура на переднем плане умещается в центральные две трети холста, иначе
  маска срезала бы волку уши.

  Третий слой, monochrome, нужен тематическим иконкам Android 13 и новее:
  без него приложение остаётся единственным цветным пятном в перекрашенном
  ряду. Он остался вектором - тематическая иконка обязана быть одноцветным
  силуэтом, и рисунок для неё не годится.

  Передний слой вписан ровно в центральные 72 из 108: у Вульфи уши почти на
  краю картинки, и при полной заливке холста маска срезала бы их первыми. Фон
  под ним - та же картинка, увеличенная, размытая и обесцвеченная: газета и
  так одноцветна, а цветной призрак куртки выдавал бы размытую копию волка
  вместо текстуры.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
